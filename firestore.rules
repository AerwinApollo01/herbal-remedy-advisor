// =============================================================================
// NYS · Firestore Security Rules  v2
// Attribute-Based Access Control (ABAC)
// Last updated: 2026-05-18
// =============================================================================
//
// Collection access matrix:
// ┌──────────────────────────────┬──────────────────┬──────────────────────────┐
// │ Path                         │ Read             │ Write / Create / Delete  │
// ├──────────────────────────────┼──────────────────┼──────────────────────────┤
// │ /protocols/{document=**}     │ isAuthenticated  │ BLOCKED (Admin SDK only) │
// │ /app_strings/{document=**}   │ isAuthenticated  │ BLOCKED (Admin SDK only) │
// │ /users/{uid}                 │ isOwner(uid)     │ isOwner + no escalation  │
// │ /users/{uid}/{document=**}   │ isOwner(uid)     │ isOwner(uid)             │
// │ /admin/{document=**}         │ BLOCKED          │ BLOCKED                  │
// │ /** (catch-all)              │ BLOCKED          │ BLOCKED                  │
// └──────────────────────────────┴──────────────────┴──────────────────────────┘
//
// Administration writes (isLifetimeArchiveUnlocked, availableTokens) are performed
// exclusively via the Firebase Admin SDK in Cloud Functions — never via client SDK.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    /// True if the request carries a verified Firebase Auth identity.
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    /// True if the authenticated user's UID exactly matches the path segment {uid}.
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    /// Guards against client-side self-escalation of sensitive monetization fields.
    /// Blocks any write that attempts to set 'isLifetimeArchiveUnlocked' or
    /// 'availableTokens' — those fields are exclusively managed by Admin SDK.
    function noMonetizationEscalation() {
      let sensitiveFields = ['isLifetimeArchiveUnlocked', 'availableTokens'];
      return !request.resource.data.keys().hasAny(sensitiveFields);
    }

    /// True if the write only touches the fields a client is permitted to set.
    /// Permitted on update: ageBracket, wellnessGoal, unlockedProtocolIDs, updatedAt.
    function isPermittedProfileUpdate() {
      let allowed = ['ageBracket', 'wellnessGoal', 'unlockedProtocolIDs', 'updatedAt'];
      return request.resource.data.keys().hasOnly(
        allowed.concat(['ageBracket', 'wellnessGoal', 'createdAt',
                        'isLifetimeArchiveUnlocked', 'availableTokens', 'unlockedProtocolIDs'])
      ) && noMonetizationEscalation();
    }

    // =========================================================================
    // PROTOCOL COLLECTION  /protocols/{document=**}
    // =========================================================================
    // Any authenticated user may read any protocol document (including sub-docs).
    // All write paths are hard-blocked — protocol content managed via Admin SDK.
    // =========================================================================

    match /protocols/{document=**} {
      allow read:                if isAuthenticated();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // APP STRINGS / REMOTE CONFIG  /app_strings/{document=**}
    // =========================================================================
    // Read-only for authenticated clients. Write: Admin SDK only.
    // =========================================================================

    match /app_strings/{document=**} {
      allow read:                if isAuthenticated();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // USER PROFILES  /users/{uid}
    // =========================================================================
    // Root profile document: strict owner-only, with escalation guard on writes.
    //
    // Create: Owner only. Allowed when creating the profile for the first time
    //         AND the write does not attempt to self-grant monetization fields.
    //
    // Update: Owner only. Permitted fields: ageBracket, wellnessGoal,
    //         unlockedProtocolIDs, updatedAt. Monetization fields are blocked.
    //
    // Delete: Hard-blocked for client SDK. Account deletion handled server-side
    //         via Admin SDK to ensure cascade cleanup of all sub-collections.
    // =========================================================================

    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && noMonetizationEscalation();
      allow update: if isOwner(uid) && isPermittedProfileUpdate();
      allow delete: if false;
    }

    // =========================================================================
    // USER SUB-COLLECTIONS  /users/{uid}/{document=**}
    // =========================================================================
    // Covers any sub-collection under the user document:
    //   /users/{uid}/journal/...     — daily journal entries
    //   /users/{uid}/preferences/... — notification and display preferences
    //   /users/{uid}/activity/...    — engagement tracking (future)
    //
    // Rule: read + write if and only if request.auth.uid == uid.
    // The zero-trust boundary means no cross-user reads are ever permitted.
    // =========================================================================

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // =========================================================================
    // ADMINISTRATION  /admin/{document=**}
    // =========================================================================
    // Completely inaccessible from client SDKs.
    // Admin SDK uses application default credentials and bypasses these rules.
    // =========================================================================

    match /admin/{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // DEFAULT DENY (catch-all)
    // =========================================================================
    // Any path not explicitly matched above is denied.
    // Principle of least privilege: new collections require an explicit rule.
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
