// =============================================================================
// NYS · Firestore Security Rules  v3
// Zero-Trust Hardened ABAC — 2026-05-18
// =============================================================================
//
// Threat model addressed:
//   • Bot scraping / unauthenticated reads        → auth guard on every collection
//   • Cross-user data access                      → strict owner-only isolation
//   • Client-side monetisation escalation         → noMonetizationEscalation guard
//   • Oversized / malformed payload injection     → server-side size caps
//   • Arbitrary token delta manipulation          → ±1 guard on availableTokens
//   • Undocumented collection enumeration         → explicit catch-all deny
//
// Administration writes (isLifetimeArchiveUnlocked, availableTokens) are performed
// exclusively via the Firebase Admin SDK — never via the client SDK. The client
// SDK is blocked from touching those fields by noMonetizationEscalation() below.
//
// Collection access matrix:
// ┌──────────────────────────────┬──────────────────┬──────────────────────────┐
// │ Path                         │ Read             │ Write / Create / Delete  │
// ├──────────────────────────────┼──────────────────┼──────────────────────────┤
// │ /protocols/{document=**}     │ isAuthenticated  │ BLOCKED (Admin SDK only) │
// │ /app_strings/{document=**}   │ isAuthenticated  │ BLOCKED (Admin SDK only) │
// │ /users/{uid}                 │ isOwner(uid)     │ isOwner + validated write│
// │ /users/{uid}/{document=**}   │ isOwner(uid)     │ isOwner(uid)             │
// │ /admin/{document=**}         │ BLOCKED          │ BLOCKED                  │
// │ /** (catch-all)              │ BLOCKED          │ BLOCKED                  │
// └──────────────────────────────┴──────────────────┴──────────────────────────┘
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // IDENTITY HELPERS
    // =========================================================================

    /// Requires a verified Firebase Auth identity token in the request.
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    /// Strict owner-only check — UID in the token must exactly match the path segment.
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // =========================================================================
    // MONETISATION ESCALATION GUARD
    // =========================================================================

    /// Blocks any client write that attempts to set or modify the two fields
    /// exclusively managed by the Admin SDK.
    ///
    /// Defence-in-depth: even if a client bypasses StoreKit and manufactures a
    /// Firestore write with isLifetimeArchiveUnlocked=true, this function
    /// causes the rule to evaluate to false and Firestore rejects the write.
    function noMonetizationEscalation() {
      return !request.resource.data.keys().hasAny(
        ['isLifetimeArchiveUnlocked', 'availableTokens']
      );
    }

    // =========================================================================
    // SERVER-SIDE INPUT VALIDATION
    // =========================================================================

    /// Asserts that text fields in a user profile write satisfy schema caps.
    /// These limits mirror InputSanitizer constants on the client — both layers
    /// must reject oversized inputs so that a bypass of one does not bypass both.
    function isValidProfileTextFields() {
      let d = request.resource.data;
      return (
        // wellnessGoal — max 100 characters
        (!d.keys().hasAny(['wellnessGoal'])
          || (d.wellnessGoal is string && d.wellnessGoal.size() <= 100)) &&
        // ageBracket — max 50 characters
        (!d.keys().hasAny(['ageBracket'])
          || (d.ageBracket is string && d.ageBracket.size() <= 50)) &&
        // notes — max 500 characters (future-proof for profile-level annotation)
        (!d.keys().hasAny(['notes'])
          || (d.notes is string && d.notes.size() <= 500)) &&
        // unlockedProtocolIDs — must be a list when present
        (!d.keys().hasAny(['unlockedProtocolIDs'])
          || d.unlockedProtocolIDs is list)
      );
    }

    /// Guards the availableTokens field against arbitrary delta manipulation.
    ///
    /// Even though noMonetizationEscalation() already blocks client writes to
    /// availableTokens entirely, this function provides defence-in-depth for any
    /// future rule relaxation: a single write may only change the value by ±1.
    ///
    /// Returns true when:
    ///   a) The write does not touch availableTokens, OR
    ///   b) The existing document does not have availableTokens (first write), OR
    ///   c) The delta between old and new value is at most 1.
    function isTokenDeltaValid() {
      let d = request.resource.data;
      let existing = resource != null ? resource.data : {};
      return (
        !d.keys().hasAny(['availableTokens']) ||
        !existing.keys().hasAny(['availableTokens']) ||
        (d.availableTokens is int &&
         existing.availableTokens is int &&
         math.abs(d.availableTokens - existing.availableTokens) <= 1)
      );
    }

    /// Composite write-gate for the user profile document.
    /// A permitted update may only touch the listed client-writable keys and must
    /// pass text size caps and the token delta guard.
    function isPermittedProfileWrite() {
      let clientWritableKeys = [
        'ageBracket', 'wellnessGoal', 'unlockedProtocolIDs', 'updatedAt',
        // Merge-safe keys that may coexist from the creation write:
        'createdAt', 'isLifetimeArchiveUnlocked', 'availableTokens'
      ];
      return (
        request.resource.data.keys().hasOnly(clientWritableKeys) &&
        noMonetizationEscalation() &&
        isValidProfileTextFields() &&
        isTokenDeltaValid()
      );
    }

    // =========================================================================
    // PROTOCOL COLLECTION  /protocols/{document=**}
    // =========================================================================
    // Any authenticated user may read any protocol document or sub-document.
    // All write paths are hard-blocked — protocol content is managed via Admin SDK.
    // =========================================================================

    match /protocols/{document=**} {
      allow read:                   if isAuthenticated();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // APP STRINGS / REMOTE CONFIG  /app_strings/{document=**}
    // =========================================================================
    // Read-only for authenticated clients. Writes are Admin SDK only.
    // =========================================================================

    match /app_strings/{document=**} {
      allow read:                   if isAuthenticated();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // USER PROFILES  /users/{uid}
    // =========================================================================
    // Root profile document:
    //
    // Create: Owner only. The initial write must not contain monetization fields
    //         (those are set by Admin SDK in the onboarding Cloud Function).
    //
    // Update: Owner only. isPermittedProfileWrite() enforces:
    //         • Allowlist of client-writable keys
    //         • noMonetizationEscalation (can't self-grant isLifetimeArchiveUnlocked)
    //         • Text field size caps (mirrors InputSanitizer constants)
    //         • Token delta guard (±1 maximum per write)
    //
    // Delete: Hard-blocked. Account deletion is handled server-side via Admin SDK
    //         to ensure cascade cleanup of all sub-collections and anonymisation.
    // =========================================================================

    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && noMonetizationEscalation() && isValidProfileTextFields();
      allow update: if isOwner(uid) && isPermittedProfileWrite();
      allow delete: if false;
    }

    // =========================================================================
    // USER SUB-COLLECTIONS  /users/{uid}/{document=**}
    // =========================================================================
    // Covers all sub-collections under the user document:
    //   /users/{uid}/journal/     — daily protocol journal entries
    //   /users/{uid}/preferences/ — notification and display settings (future)
    //   /users/{uid}/activity/    — engagement analytics (future)
    //
    // Zero-trust boundary: read + write only when request.auth.uid == uid.
    // No cross-user reads are ever permitted.
    // =========================================================================

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // =========================================================================
    // ADMINISTRATION  /admin/{document=**}
    // =========================================================================
    // Completely inaccessible from client SDKs.
    // Admin SDK bypasses these rules using application default credentials.
    // =========================================================================

    match /admin/{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // DEFAULT DENY — catch-all
    // =========================================================================
    // Any path not explicitly matched above is denied. Principle of least
    // privilege: new collections require an explicit rule before they are
    // accessible. This gate eliminates undocumented collection enumeration.
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
